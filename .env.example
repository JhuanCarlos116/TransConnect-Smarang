# Referensi semua env var yang dipakai frontend & backend.
# Isi yang sebenarnya ada di frontend/.env.local dan backend/.env (masing-masing, tidak di-commit).

# --- frontend/.env.local ---
# API Key dari geo.mapid.io Dashboard > Map Services > API Keys.
# Dipakai untuk basemap MAPID (MapLibre GL) — bukan Mapbox.
NEXT_PUBLIC_MAPID_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- backend/.env ---
DATABASE_URL=postgresql+asyncpg://transconnect:transconnect@localhost:5432/transconnect_semarang
CORS_ORIGINS=http://localhost:3000
GEOMAPID_API_KEY=
# API Key dari aistudio.google.com > Get API key. Dipakai untuk lapisan chatbot
# rekomendasi halte baru -- LLM ini cuma menjelaskan hasil Location Allocation
# Model (backend/scripts/build_location_allocation.py) dalam bahasa natural,
# bukan yang menentukan lokasinya sendiri.
GEMINI_API_KEY=

# --- dipakai manual (bukan disimpan di .env) saat menjalankan curl untuk
# tarik data survei via endpoint Activities, lihat README ---
# x-api-key: <API Key Mission dari geo.mapid.io>

# --- docker-compose.yml (postgis service) ---
POSTGRES_USER=transconnect
POSTGRES_PASSWORD=transconnect
POSTGRES_DB=transconnect_semarang
